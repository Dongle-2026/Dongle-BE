# Copy to .env.deploy; fill secrets before running. Never commit .env.deploy.
DB_NAME=youthletter
DB_USERNAME=youthletter
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
APP_CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
OAUTH2_REDIRECT_URI=https://YOUR_FRONTEND_DOMAIN/auth/callback
KAKAO_CLIENT_ID=not-configured
KAKAO_CLIENT_SECRET=not-configured
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
GOOGLE_MOBILE_CLIENT_IDS=
KAKAO_APP_KEYS=
AI_USE_STUB=false
AI_JOBS_ENABLED=true
AI_SERVICE_BASE_URL=http://ai-service:3000
AI_SERVICE_TOKEN=CHANGE_ME_GENERATE_A_RANDOM_SECRET
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# 수집 스케줄러가 깨는 주기(ms, 기본 30분; 언론사별 주기는 CRAWLER_*_INTERVAL_MS)와 한경 섹션
CONTENT_PIPELINE_INTERVAL_MS=1800000
CRAWLER_SECTIONS=economy,koreamarket/,realestate
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
